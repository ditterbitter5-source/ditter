<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ditterbitter's Sports Bet Tracker</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #1a202c;
            color: #e2e8f0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* Custom styles for smaller status buttons */
        .status-btn {
            padding: 0.25rem 0.5rem; /* Reduced padding */
            font-size: 0.75rem; /* Smaller font size */
            line-height: 1rem;
        }
    </style>
</head>
<body class="p-4">
    <div id="app" class="w-full max-w-4xl p-6 bg-gray-800 rounded-2xl shadow-xl flex flex-col items-center">
        <h1 class="text-3xl font-bold text-center mb-2">Ditterbitter's Sports Bet Tracker</h1>
        <p class="text-sm text-gray-400 text-center mb-6">Use code "ditter" at shuffle.com</p>

        <!-- User ID display for debugging and sharing -->
        <div id="userIdDisplay" class="text-xs text-gray-400 mb-4 text-center"></div>

        <!-- Bet Summary Section -->
        <div class="w-full grid grid-cols-1 sm:grid-cols-3 gap-2 mb-6 text-center">
            <div class="p-3 bg-green-600 rounded-xl shadow-lg">
                <p class="text-xl font-bold" id="winsCount">0</p>
                <p class="text-xs font-semibold">WINS</p>
            </div>
            <div class="p-3 bg-red-600 rounded-xl shadow-lg">
                <p class="text-xl font-bold" id="lossesCount">0</p>
                <p class="text-xs font-semibold">LOSSES</p>
            </div>
            <div class="p-3 bg-yellow-500 rounded-xl shadow-lg">
                <p class="text-xl font-bold" id="pendingCount">0</p>
                <p class="text-xs font-semibold">PENDING</p>
            </div>
        </div>

        <!-- Profit/Loss Chart -->
        <div class="w-full p-4 bg-gray-700 rounded-xl shadow-inner mb-6">
            <h2 class="text-xl font-semibold mb-2 text-center">Total P/L</h2>
            <canvas id="profitLossChart" style="max-height: 250px;"></canvas>
        </div>

        <!-- Add Bet Section -->
        <div class="w-full p-4 bg-gray-700 rounded-xl shadow-inner mb-6">
            <h2 class="text-xl font-semibold mb-3 text-center">Add a New Bet</h2>
            <form id="addBetForm" class="space-y-3">
                <div>
                    <label for="betName" class="block text-xs font-medium mb-1">Bet Description</label>
                    <input type="text" id="betName" class="w-full p-2 rounded-lg bg-gray-600 border border-gray-500 text-sm focus:outline-none focus:ring focus:ring-blue-500" required>
                </div>
                <div>
                    <label for="betAmount" class="block text-xs font-medium mb-1">Amount ($)</label>
                    <input type="number" id="betAmount" step="any" class="w-full p-2 rounded-lg bg-gray-600 border border-gray-500 text-sm focus:outline-none focus:ring focus:ring-blue-500" required>
                </div>
                <div>
                    <label for="betPayout" class="block text-xs font-medium mb-1">Payout ($)</label>
                    <input type="number" id="betPayout" step="any" class="w-full p-2 rounded-lg bg-gray-600 border border-gray-500 text-sm focus:outline-none focus:ring focus:ring-blue-500" required>
                </div>
                <div class="flex items-center space-x-2 text-sm">
                    <input type="radio" id="pending" name="status" value="pending" checked class="h-4 w-4 text-blue-600 border-gray-500 focus:ring-blue-500">
                    <label for="pending" class="text-sm font-medium">Pending</label>
                    <input type="radio" id="win" name="status" value="win" class="h-4 w-4 text-blue-600 border-gray-500 focus:ring-blue-500">
                    <label for="win" class="text-sm font-medium">Win</label>
                    <input type="radio" id="loss" name="status" value="loss" class="h-4 w-4 text-blue-600 border-gray-500 focus:ring-blue-500">
                    <label for="loss" class="text-sm font-medium">Loss</label>
                </div>
                <button type="submit" class="w-full p-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg shadow-md text-sm transition-all duration-200">Add Bet</button>
            </form>
        </div>

        <!-- Bet List Section -->
        <div class="w-full p-4 bg-gray-700 rounded-xl shadow-inner">
            <h2 class="text-xl font-semibold mb-3 text-center">Bet History</h2>
            <div id="betList" class="space-y-2">
                <div id="loading" class="text-center text-gray-400">Loading bets...</div>
                <!-- Bets will be dynamically added here -->
            </div>
        </div>

    </div>

    <!-- Error/Message Modal -->
    <div id="messageModal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-75 flex items-center justify-center p-4 z-50">
        <div class="bg-gray-800 p-6 rounded-xl shadow-2xl w-full max-w-sm text-center">
            <p id="messageText" class="text-lg font-semibold mb-4"></p>
            <button id="closeModal" class="p-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors duration-200">Close</button>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInWithCustomToken, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, onSnapshot, doc, deleteDoc, updateDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        import { setLogLevel } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";
        setLogLevel('debug');

        // Global variables for Firebase and Chart
        let app, db, auth, userId, profitLossChart;

        // Custom modal for messages
        const messageModal = document.getElementById('messageModal');
        const messageText = document.getElementById('messageText');
        const closeModalButton = document.getElementById('closeModal');

        const showMessage = (message) => {
            messageText.textContent = message;
            messageModal.classList.remove('hidden');
        };

        closeModalButton.addEventListener('click', () => {
            messageModal.classList.add('hidden');
        });

        // Firebase Initialization and Authentication
        const firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}');
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        const initFirebase = async () => {
            try {
                if (Object.keys(firebaseConfig).length > 0) {
                    app = initializeApp(firebaseConfig);
                    auth = getAuth(app);
                    db = getFirestore(app);

                    if (initialAuthToken) {
                        await signInWithCustomToken(auth, initialAuthToken);
                    } else {
                        await signInAnonymously(auth);
                    }

                    auth.onAuthStateChanged(async (user) => {
                        if (user) {
                            userId = user.uid;
                            document.getElementById('userIdDisplay').textContent = `User ID: ${userId}`;
                            setupRealtimeListener();
                        } else {
                            // User is signed out
                            document.getElementById('userIdDisplay').textContent = "User not authenticated.";
                        }
                    });
                } else {
                    showMessage("Firebase config is missing. The app will not work.");
                }
            } catch (error) {
                console.error("Error initializing Firebase:", error);
                showMessage(`Firebase initialization failed: ${error.message}`);
            }
        };

        const setupRealtimeListener = () => {
            const betsRef = collection(db, `artifacts/${appId}/public/data/bets`);
            onSnapshot(betsRef, (snapshot) => {
                const bets = [];
                snapshot.forEach(doc => {
                    bets.push({ id: doc.id, ...doc.data() });
                });
                renderBets(bets);
                updateSummary(bets);
                updateChart(bets);
            }, (error) => {
                console.error("Error fetching bets:", error);
                showMessage(`Failed to load bets: ${error.message}`);
            });
        };

        const renderBets = (bets) => {
            const betList = document.getElementById('betList');
            betList.innerHTML = '';
            
            const loadingElement = document.getElementById('loading');
            if (loadingElement) {
                loadingElement.style.display = 'none';
            }

            if (bets.length === 0) {
                betList.innerHTML = '<p class="text-center text-gray-500">No bets added yet.</p>';
                return;
            }

            // Sort bets by date added (assuming Firebase adds a timestamp)
            const sortedBets = bets.sort((a, b) => b.timestamp?.toDate() - a.timestamp?.toDate());

            sortedBets.forEach(bet => {
                const betItem = document.createElement('div');
                betItem.className = `p-3 rounded-lg shadow-md transition-all duration-200 flex flex-col sm:flex-row sm:items-center justify-between space-y-2 sm:space-y-0 ${getBetColor(bet.status)}`;

                const amountText = bet.amount !== undefined ? `$${bet.amount.toFixed(2)}` : 'N/A';
                const payoutText = bet.payout !== undefined ? `$${bet.payout.toFixed(2)}` : 'N/A';
                const netProfitText = bet.status === 'win' ? `$${(bet.payout - bet.amount).toFixed(2)}` : '';
                const profitColor = bet.payout > bet.amount ? 'text-green-400' : 'text-red-400';

                betItem.innerHTML = `
                    <!-- Bet Name, Amount, and Payout -->
                    <div class="flex-grow text-center sm:text-left">
                        <p class="font-bold text-sm sm:text-base">${bet.name}</p>
                        <p class="text-xs text-gray-300">Amount: ${amountText} / Payout: ${payoutText} <span class="${profitColor}">${netProfitText}</span></p>
                    </div>
                    
                    <!-- Status buttons and delete button -->
                    <div class="flex items-center space-x-1 justify-center sm:justify-start">
                        <button class="status-btn rounded-lg text-xs transition-colors duration-200 ${bet.status === 'pending' ? 'bg-yellow-500' : 'bg-transparent border border-yellow-500'}" data-status="pending" data-id="${bet.id}">Pending</button>
                        <button class="status-btn rounded-lg text-xs transition-colors duration-200 ${bet.status === 'win' ? 'bg-green-600' : 'bg-transparent border border-green-600'}" data-status="win" data-id="${bet.id}">Win</button>
                        <button class="status-btn rounded-lg text-xs transition-colors duration-200 ${bet.status === 'loss' ? 'bg-red-600' : 'bg-transparent border border-red-600'}" data-status="loss" data-id="${bet.id}">Loss</button>
                        <button class="delete-btn p-1 text-red-500 hover:text-red-700 transition-colors duration-200" data-id="${bet.id}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm4 0a1 1 0 112 0v6a1 1 0 11-2 0V8z" clip-rule="evenodd" />
                            </svg>
                        </button>
                    </div>
                `;
                betList.appendChild(betItem);
            });

            // Add event listeners to the new buttons
            betList.querySelectorAll('.status-btn').forEach(button => {
                button.addEventListener('click', async (e) => {
                    const id = e.target.dataset.id;
                    const status = e.target.dataset.status;
                    const betDocRef = doc(db, `artifacts/${appId}/public/data/bets`, id);
                    try {
                        await updateDoc(betDocRef, { status: status });
                    } catch (e) {
                        console.error("Error updating document: ", e);
                        showMessage("Error updating bet status. Please try again.");
                    }
                });
            });

            betList.querySelectorAll('.delete-btn').forEach(button => {
                button.addEventListener('click', async (e) => {
                    const id = e.target.dataset.id;
                    const betDocRef = doc(db, `artifacts/${appId}/public/data/bets`, id);
                    try {
                        await deleteDoc(betDocRef);
                    } catch (e) {
                        console.error("Error deleting document: ", e);
                        showMessage("Error deleting bet. Please try again.");
                    }
                });
            });
        };

        const getBetColor = (status) => {
            switch (status) {
                case 'win': return 'bg-green-700';
                case 'loss': return 'bg-red-700';
                default: return 'bg-yellow-700';
            }
        };

        const updateSummary = (bets) => {
            const wins = bets.filter(b => b.status === 'win').length;
            const losses = bets.filter(b => b.status === 'loss').length;
            const pending = bets.filter(b => b.status === 'pending').length;

            document.getElementById('winsCount').textContent = wins;
            document.getElementById('lossesCount').textContent = losses;
            document.getElementById('pendingCount').textContent = pending;
        };

        const updateChart = (bets) => {
            const totalWins = bets.filter(b => b.status === 'win').reduce((sum, bet) => sum + (bet.payout - bet.amount), 0);
            const totalLosses = bets.filter(b => b.status === 'loss').reduce((sum, bet) => sum + bet.amount, 0);
            
            const data = {
                labels: ['Total Profit', 'Total Loss'],
                datasets: [{
                    label: 'Total Amount ($)',
                    data: [totalWins, totalLosses],
                    backgroundColor: [
                        'rgba(34, 197, 94, 0.6)', // Green
                        'rgba(239, 68, 68, 0.6)', // Red
                    ],
                    borderColor: [
                        'rgb(34, 197, 94)',
                        'rgb(239, 68, 68)',
                    ],
                    borderWidth: 1
                }]
            };

            const config = {
                type: 'bar',
                data: data,
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            },
                            ticks: {
                                color: '#cbd5e1'
                            }
                        },
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.1)'
                            },
                            ticks: {
                                color: '#cbd5e1'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: false
                        }
                    }
                }
            };

            const chartCanvas = document.getElementById('profitLossChart');
            if (profitLossChart) {
                profitLossChart.destroy();
            }
            profitLossChart = new Chart(chartCanvas, config);
        };


        // Form Submission
        document.getElementById('addBetForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const betName = document.getElementById('betName').value;
            const betAmount = document.getElementById('betAmount').value;
            const betPayout = document.getElementById('betPayout').value;
            const status = document.querySelector('input[name="status"]:checked').value;

            if (!betName || !betAmount || !betPayout) {
                showMessage("Please fill in all fields.");
                return;
            }

            try {
                const betsRef = collection(db, `artifacts/${appId}/public/data/bets`);
                await addDoc(betsRef, {
                    name: betName,
                    amount: parseFloat(betAmount),
                    payout: parseFloat(betPayout),
                    status: status,
                    timestamp: new Date()
                });
                document.getElementById('addBetForm').reset();
            } catch (e) {
                console.error("Error adding document: ", e);
                showMessage("Error adding bet. Please try again.");
            }
        });

        // Initialize on page load
        window.onload = initFirebase;
    </script>
</body>
</html>
